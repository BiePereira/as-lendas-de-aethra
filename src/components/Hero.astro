---
import {Image} from "astro:assets";
import capaPersonagens from "../assets/images/personagens.png";
---

<main class="hero">

    <div class="hero-background">
        <Image
            src={capaPersonagens}
            alt=""
            loading="eager"
            fetchpriority="high"
        />
    </div>

    <div class="hero-content">
        <h1>A Emissária Mudante</h1>
        <p class="description">
            Entre florestas antigas, cidades esquecidas e histórias
            que ainda precisam ser contadas.
        </p>

        <a class="button" href="#">
            Entrar neste mundo
        </a>
    </div>
</main>

<style>
    .hero {
		min-height: 90vh;

		display: flex;
		align-items: center;

		padding: 8rem 10%;

		position: relative;
		overflow: hidden;

		background:
        linear-gradient(
            90deg,
            #0b1510 0%,
            #0b1510cc 45%,
            #0b151000 100%
        );
	}

	.hero-background {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

    .hero-background img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center 30%;
    }

	.hero-background::after {
		content: "";

		position: absolute;
		inset: 0;

		background:
            linear-gradient(
                to bottom,
                rgba(11, 21, 16, 0) 60%,
                #0b1510 100%
            )
            rgba(11, 21, 16, 0.35);
	}

    .hero-content {
        max-width: 1000px;
		z-index: 1;
        transform: translateY(80px); /*Baixa os conteúdos para não ficarem na cara da personagem */
    }

    .hero h1{
        margin: 0;
        line-height: 1;
        font-weight: 400;
        font-size: clamp(3rem, 5vw, 5rem); /* clamp para o tamanho crescer dentro dos limites */
    }

    .description {
        min-width: 1.15rem;
        font-size: 1.2rem;
        line-height: 1.8;
        color: #c9c2b7;
    }

    .button {
        display: inline-block;

        margin-top: 2rem;
        padding: 1rem 1.5rem;

        border: 1px solid #c66a3d;

        color: #e8e1d5;
        text-decoration: none;
    }

    @media (max-width: 800px) {
        .hero {
			padding: 6rem 1.5rem;
		}
    }
</style>