---
import imagemCapa from "../assets/images/capa-livro.png";
---

<section class="book">
    <div class="book-text">
        <p class="eyebrow">VOLUME I</p>

        <h2>A Emissária Mudante</h2>

        <p>
            Em um mundo onde antigas histórias ainda ecoam entre
            cidades, florestas e desertos, uma nova jornada começa.
        </p>

        <p>
            Este é o primeiro volume de As Lendas de Aethra.
        </p>
        <a class="book-button" href="#">
            Conheça o livro
        </a>
    </div>

    <div class="book-cover">
        <img src={imagemCapa.src} alt="A Emissária Mudante" />
    </div>
</section>

<style>
    .book {
		display: grid;
		grid-template-columns: 1.2fr 0.8fr;
		gap: 4rem;

		align-items: center;

		padding: 8rem 10%;

		background: #101c15;
	}

	.book h2 {
		font-size: 3.5rem;
		margin: 0.5rem 0 2rem;
	}
	
	.book-text p {
		color: #c9c2b7;
		line-height: 1.8;
	}

	.book-button {
		display: inline-block;

		margin-top: 2rem;
		padding: 1rem 1.5rem;

		border: 1px solid #c66a3d;

		color: #e8e1d5;
		text-decoration: none;

		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.book-button:hover {
		background: #c66a3d;
		color: #0b1510;
	}

	.book-cover {
		aspect-ratio: 2 / 3;

		display: flex;
		align-items: center;
		justify-content: center;

		background: #26352a;
		box-shadow: 0 25px 60px rgba(0, 0, 0, 0.45);
		overflow: hidden;
        width: min(100%, 380px);

		border: 2px solid rgba(216, 154, 74, 0.25);
		transform: rotate(1deg);

		position: relative;
	}

	/*efeitos de páginas ao lado da capa, como se fosse um livro*/
	.book-cover::after {
		content: "";
		position: absolute;
		top: 2px;
		right: 0;
		width: 5px;
		height: calc(100% - 4px);

		background: linear-gradient(
			to right,
			#b8b0a1,
			#e0d8c8,
			#a9a294
		);

		opacity: 0.9;
	}

	.book-cover img {
		width: 100%;
		height: 100%;

		object-fit: fill;
	}

	@media (max-width: 800px) {
		.book {
			grid-template-columns: 1fr;
			padding: 5rem 1.5rem;
		}

		.book h2 {
			font-size: 2.5rem;
		}

		.book-cover {
			margin: 0 auto;
		}
	}
</style>