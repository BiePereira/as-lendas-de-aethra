---
import {links} from "../data/navegacao.js";
import {getPath} from "../utils/paths.js";
---

<header class="topbar">
    <div class="logo">AS LENDAS DE AETHRA</div>

    <nav>
        {links.map((link) => (
                <a href={`${getPath()}${link.destino}`}>{link.texto}</a>
            )
        )}
    </nav>
</header>

<style>
    .topbar {
        position: absolute; /*não ocupa espaço*/
        top: 0;
        left: 0;
        width: 100%;

        display: flex;
        justify-content: space-between;
        align-items: center;

        padding: 3rem 5%;

        z-index: 10;
    }

    .logo {
        font-size: 1.2rem;
        letter-spacing: 0.2em;
        color: #f0eadf;
        font-weight: 600;

        text-shadow: 0 2px 8px rgba(0,0,0,0.8);
    }

    nav {
         display: flex;
        gap: 1.8rem;

        padding: 0.8rem 1.8rem;

        background:
            linear-gradient(
                to bottom,
                #e3d1a7,
                #d2bc8e 50%,
                #c4a976
            );
        border: none;

        box-shadow:
            0 6px 14px rgba(0, 0, 0, 0.5),
            inset 0 1px 2px rgba(255, 255, 255, 0.45),
            inset 0 -3px 8px rgba(88, 61, 25, 0.2);

        position: relative;

        outline: 7px solid #8f774f;
        outline-offset: 11px;

        /*rasgos irregulares no pergaminho do nav*/
        clip-path: polygon(
            1% 8%,
            7% 4%,
            15% 6%,
            24% 3%,
            34% 5%,
            45% 3%,
            57% 6%,
            68% 4%,
            78% 6%,
            88% 3%,
            98% 7%,
            97% 92%,
            89% 96%,
            78% 93%,
            68% 97%,
            56% 94%,
            45% 97%,
            34% 94%,
            23% 96%,
            13% 93%,
            3% 96%
        ); /*Creindeuspai*/
    }

    nav a {
        color: #3d3020;
        text-decoration: none;

        font-size: 0.9rem;
        font-weight: 600;
        letter-spacing: 0.04em;

        transition:
            color 0.2s ease,
            text-shadow 0.2s ease;
    }

    nav a:hover{
        color: #171108;
        text-shadow: 0 5px 5px rgba(255,255,255,0.55);
    }


    @media (max-width: 800px) {
		.topbar {
			padding: 1.5rem;
		}

		nav {
			display: none;
		}
	}

</style>