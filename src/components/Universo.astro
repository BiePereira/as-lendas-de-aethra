---
import imagemMundo from "../assets/images/tarisia.png";
import mapaPergaminho from "../assets/images/mapa-desenhado.png";
import imagemBiblioteca from "../assets/images/biblioteca.png";
import imagemLivro from "../assets/images/livro-historia.png";
---
<section id="universo" class="universe">

    <div class="universe-scene">
       
        <img
            src={imagemBiblioteca.src}
            alt=""
            class="scene-background"
        />

        <!--aria-hidden diz que não há nada a ser visto aqui para os leitores de tela -->
        <div class="particles" aria-hidden="true"></div> 

        <h2 class="scene-title">Universo</h2>
        
        <a class="world-link hotspot" href="mundo">
            <img src={imagemMundo.src} alt="O mundo">
        </a>

        <a class="map-link hotspot" href="regioes">
            <img src={mapaPergaminho.src} alt="As regiões">
            <span>Regiões de Tarísia</span>
        </a>

        <a class="book-link" href="historia" >
            <img class="hotspot" src={imagemLivro.src} alt="A História">
            <img src={imagemLivro.src} alt="" class="book-shadow">
        </a>
    </div>
</section>

<script>
    console.log("particles script funcionando");
    const particles = document.querySelector(".particles");
    const cores = [
        "#e8e1d5",
        "#d8c58a",
        "#9fc7a5",
        "#b7c9d6"
    ];

    const quantidade = window.innerWidth <= 800 ? 125 : 500;

    if (particles) {
        for(let i = 0; i < quantidade; i++){
            const particle = document.createElement("span");
            const size = 1 + Math.random() * 2.5;
            const left = Math.random() * 100;
            const top = -7 + Math.random() * 14;
            
            particle.style.width = `${size}px`;
            particle.style.height = `${size}px`;
            particle.style.left = `${left}%`;
            particle.style.top = `${top}%`;
            
            const duration = 5 + Math.random() * 8;
            particle.style.animationDuration = `${duration}s`;

            const cor = cores[Math.floor(Math.random() * cores.length)]
            particle.style.background = cor;
            particle.style.boxShadow = `
                0 0 4px ${cor},
                0 0 10px ${cor}
            `;

            particles.appendChild(particle);
        }
    }
</script>

<style>
    .universe-scene {
        position: relative;
        background-color: #101c15;
    }

    .scene-background {
        display: block;
        width: 100%;
        height: auto;

        -webkit-mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            black 10%
        );

        mask-image: linear-gradient(
            to bottom,
            transparent 0%,
            black 10%
        );
    }

    .particles {
        position: absolute;
        inset: 0;
        pointer-events: none; /*ignora o mouse*/
        z-index: 1;
    }
    
    /*diz para o Astro que o seletor é global, caso contrário ele não reconhece
    a classe e elemento html criado por JavaScript*/
    :global(.particles span) { 
        position: absolute;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #ed0808;
        top: 5%;
        left: 20%;

        animation: drift 6s ease-in-out infinite;
    }

    @keyframes drift {
        0%, 100% {
            transform: translate(0, 0);
        }

        50% {
            transform: translate(10px, -8px);
        }
    }

    .scene-title {
        position: absolute;
        top: 8%;
        left: 50%;
        transform: translateX(-50%);


         font-size: 3.5rem;
        margin: 0.5rem 0 1rem;
        color: #e8e1d5;

        text-shadow:
            0 2px 8px rgba(0, 0, 0, 0.8),
            0 0 20px rgba(216, 154, 74, 0.4);
        z-index: 1;
    }

    .world-link {
        position: absolute;
        top: 64%;
        left: 6.3%;
        width: 15%;
    }

    .world-link img {
        display: block;
        width: 100%;
        filter: blur(0.5px);
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 50%;
        /*closest-side para não levar em consideração
        a margem da imagem quadrada (original)*/
        mask-image: radial-gradient(
            circle closest-side,
            black 75%,
            transparent 100%
        );

        -webkit-mask-image: radial-gradient(
            circle closest-side,
            black 75%,
            transparent 100%
        );

        animation: float 4s ease-in-out infinite;
    }

    @keyframes float {
        0% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }

        100% {
            transform: translateY(0);
        }
    }

    .world-link:hover {
       filter:
            brightness(1.25)
           drop-shadow(0 0 10px rgba(255, 220, 150, 0.9))
           drop-shadow(0 0 25px rgba(255, 200, 100, 0.7))
           drop-shadow(0 0 50px rgba(255, 180, 70, 0.5))
           drop-shadow(0 0 80px rgba(255, 160, 50, 0.3)); 
    }

    .map-link {
        position: absolute;
        top: 63%;
        left: 55%;
        width: 17%;
        text-decoration: none;
        color: #342f26;

    }

    .map-link img {
        display: block;
        width: 100%;
        
        aspect-ratio: 1;
        overflow: hidden;
        filter: brightness(0.2);
        transform: rotate(-30deg);
        transition: filter 0.3s ease;
    }

    .map-link span{
        position: absolute;
        
        top: 40%;
        left: 105%;
        width: max-content;
        transform: translateX(-50%);
        margin-top: 0.5rem;
        text-align: center;
        transition: filter 0.3s ease;
        font-family: "Tangerine", cursive;
        font-size: 2rem;
        transform: rotate(-25deg);

    }

    .map-link:hover img, .map-link:hover span {
        filter: brightness(3.2)
            drop-shadow(1 1 12px rgba(255, 220, 150, 0.5));
        color: rgba(255, 239, 208, 0.568);
    }

    .book-link {
        position: absolute;
        top: 31%;
        left: 72%;
        width: 10%;
    }

    .book-link > img:first-child {
        display: block;
        width: 100%;
        
        aspect-ratio: 1;
        overflow: hidden;
        filter:
            brightness(0.45)
            drop-shadow(9px 7px 6px rgba(0, 0, 0, 0.7));;
        transition: filter 0.3s ease;
    }

    .book-shadow {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;

        /* transforma o livro da segunda cópia em uma silhueta preta */
        filter: brightness(0.2);

        /* só a parte de cima da silhueta aparece */
        mask-image: linear-gradient(
            to bottom left,
            black 0%,
            transparent 65%
        );

        -webkit-mask-image: linear-gradient(
            to bottom left,
            black 0%,
            transparent 65%
        );

        pointer-events: none;
        transition: filter 0.3s ease;

    }

    .book-link:hover {
       filter:
            brightness(3.55)
           drop-shadow(0 0 10px rgba(255, 220, 150, 0.9))
           drop-shadow(0 0 25px rgba(255, 200, 100, 0.7))
           drop-shadow(0 0 50px rgba(255, 180, 70, 0.5))
           drop-shadow(0 0 80px rgba(255, 160, 50, 0.3)); 
    }

    .book-link:hover .book-shadow {
        opacity: 0;
    }

    @media (max-width: 800px) {
        .map-link span {
            font-size: 1.2rem;
        }
    }

    /* Ativa a iluminação constante apenas em dispositivos com tela de toque */
    @media (pointer: coarse) {
        .hotspot {
            animation: pulseGlow 2.5s infinite ease-in-out;
        }
    }

    @keyframes pulseGlow {
        0%, 100% {
            opacity: 0.5;
            filter: drop-shadow(0 0 2px rgba(255, 188, 130, 0.5));
        }
        50% {
            opacity: 1.0;
            filter: drop-shadow(0 0 10px rgba(255, 191, 117, 0.9));
        }
    }

</style>