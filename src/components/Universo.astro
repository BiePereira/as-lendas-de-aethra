---
import imagemMundo from "../assets/images/tarisia.png";
import mapaPergaminho from "../assets/images/mapa-desenhado.png";
import imagemBiblioteca from "../assets/images/biblioteca.png";
---
<section id="universo" class="universe">
    <div class="universe-scene">
       
        <img
            src={imagemBiblioteca.src}
            alt=""
            class="scene-background"
        />
        
        <a class="world-link" href="mundo">
            <img src={imagemMundo.src} alt="O mundo">
        </a>

        <a class="map-link" href="regioes">
            <img src={mapaPergaminho.src} alt="As regiões">
            <span>Regiões de Tarísia</span>
        </a>
    </div>
</section>

<style>
    .universe-scene {
        position: relative;
    }

    .scene-background {
        display: block;
        width: 100%;
        height: auto;
    }

    .world-link {
        position: absolute;
        top: 64%;
        left: 6.3%;
        width: 15%;
    }

    .world-link img {
        display: block;
        width: 100%;
        
        aspect-ratio: 1;
        overflow: hidden;
        border-radius: 50%;
        mask-image: radial-gradient(
            circle,
            black 75%,
            transparent 100%
        );

        -webkit-mask-image: radial-gradient(
            circle,
            black 100%,
            transparent 100%
        );

        animation: float 4s ease-in-out infinite;
    }

    @keyframes float {
        0% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-5px);
        }

        100% {
            transform: translateY(0);
        }
    }

    .world-link:hover {
       filter:
            brightness(1.25)
           drop-shadow(0 0 10px rgba(255, 220, 150, 0.9))
           drop-shadow(0 0 25px rgba(255, 200, 100, 0.7))
           drop-shadow(0 0 50px rgba(255, 180, 70, 0.5))
           drop-shadow(0 0 80px rgba(255, 160, 50, 0.3)); 
    }

    .map-link {
        position: absolute;
        top: 63%;
        left: 55%;
        width: 17%;
        text-decoration: none;
        color: #5e584e;

    }

    .map-link img {
        display: block;
        width: 100%;
        
        aspect-ratio: 1;
        overflow: hidden;
        filter: brightness(0.5);
        transform: rotate(-30deg);
        transition: filter 0.3s ease;
    }

    .map-link span{
        position: absolute;
        
        top: 40%;
        left: 105%;
        width: max-content;
        transform: translateX(-50%);
        margin-top: 0.5rem;
        text-align: center;
        transition: filter 0.3s ease;
        font-family: "Tangerine", cursive;
        font-size: 2rem;
        transform: rotate(-25deg);

    }

    .map-link:hover img, .map-link:hover span {
        filter: brightness(1.2)
            drop-shadow(0 0 8px rgba(255, 220, 150, 0.5));
        color: rgba(255, 239, 208, 0.568);
    }

    @media (max-width: 800px) {
    .map-link span {
        font-size: 1.2rem;
    }
}

</style>