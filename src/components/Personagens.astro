---
import imagemKaelis from "../assets/images/kaelis.png";
import imagemGaren from "../assets/images/garen.jpg";
import imagemRiel from "../assets/images/riel.png";

const personagens = [
    {
        nome: "Kaelis",
        descricao: "A druidesa de Becanlar.",
        imagem: imagemKaelis.src
    },
    {
        nome: "Garen",
        descricao: "O guardião de Vau dos Gansos.",
        imagem: imagemGaren.src
    },
    {
        nome: "Riel",
        descricao: "O ladino de Vardis.",
        imagem: imagemRiel.src
    },
];
---

<section id="personagens" class="characters">
    <div class="characters-content">
        <p class="eyebrow">PERSONAGENS</p>

        <h2>Aqueles que habitam Aethra</h2>

        <div class="divider"></div>

        <p>
            Heróis, aliados, inimigos e figuras que carregam
            suas próprias histórias.
        </p>
    </div>

    <div class="character-cards">
        {personagens.map((personagem) => (
            <article class="character-card">
                <div class="character-image">
                    <img src={personagem.imagem} alt={personagem.nome}>
                </div>
                <div class="character-info">
                    <h3>{personagem.nome}</h3>
                    <p>{personagem.descricao}</p>
                    <a href="#">Conhecer Personagem</a>
                </div>
            </article>
        ))}
    </div>

</section>

<style>
    .characters {
        padding: 8rem 10%;
        background: #101c15;
    }

    .characters-content {
        max-width: 700px;
        margin: 0 auto 4rem;
        text-align: center;
    }

    .characters h2 {
        font-size: 3.5rem;
        margin: 0.5rem 0 1rem;
    }

    .characters-content > p:last-child {
        color: #c9c2b7;
        line-height: 1.8;
    }

    .divider {
        width: 80px;
        height: 1px;
        margin: 2rem auto;
        background: #c66a3d;
    }

    .character-cards {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .character-card {
        padding: 2rem;
        background: #14251b;
        border: 1px solid #284535;
        overflow: hidden;
        
        transition:
        transform 0.3s ease,
            border-color 0.3s ease;
    }

    .character-card:hover {
        transform: translateY(-8px);
        border-color: #c66a3d;
    }

    .character-image {
        aspect-ratio: 3 / 4;
        overflow: hidden;
        background: #26352a;
    }

    .character-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;

        transition: transform 0.5s ease;
    }

    .character-card:hover .character-image img {
        transform: scale(1.05);
    }

    .character-info {
        padding: 2rem;
    }

    .character-card h3 {
        margin: 0 0 1rem;
        font-size: 1.8rem;
    }

    .character-card p {
        margin: 0;
        color: #c9c2b7;
        line-height: 1.7;
    }

    .character-card a {
        display: inline-block;
        margin-top: 1.5rem;

        color: #d89a4a;
        text-decoration: none;

        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-size: 0.85rem;
    }

    @media (max-width: 800px) {
        .characters {
            padding: 5rem 1.5rem;
        }

        .characters h2 {
            font-size: 2.5rem;
        }

        .character-cards {
            grid-template-columns: 1fr;
        }

        .character-image {
            aspect-ratio: 4 / 3;
        }

        /*para não cortar os pescoços dos personagens no celular*/
        .character-image img {
            object-position: center 5%;
        }

        .character-info {
            padding: 1.5rem;
        }
    }
</style>